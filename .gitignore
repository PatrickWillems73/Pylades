secrets/*
!secrets/.gitkeep

# Gearchiveerde HMAC-sleutels na rotatie (BR-C01 sleutelrotatie-flow).
*.bin.archived-*

# --- Environment -------------------------------------------------------------
.env
.env.local
.env.*.local

