# Pylades v0.3 — voorbeeldconfiguratie
# Kopieer dit bestand naar `.env` en vul de waardes in.
# Alle keys mappen 1-op-1 op velden in `shared/config.py` (pydantic-settings).

# --- Verplicht ---------------------------------------------------------------

# Anthropic API-sleutel (https://console.anthropic.com/).
# Zonder deze key faalt elke /v1/messages-call met een 401 van Anthropic.
ANTHROPIC_API_KEY=

# --- Databases (BR-G02: strikt gescheiden) -----------------------------------

# Content-DB: templates, audit_log, sessions, review_queue, config.
CONTENT_DB_PATH=./pylades-content.db

# Vault-DB: pseudoniem-mappings. File-mode wordt runtime op 0o600 gezet.
VAULT_DB_PATH=./pylades-vault.db

# --- Crypto (BR-C01) ---------------------------------------------------------

# Pad naar de globale HMAC-sleutel (32 random bytes, mode 0o600).
# Wordt automatisch gegenereerd bij eerste run als het bestand niet bestaat.
GLOBAL_SECRET_PATH=./secrets/global_secret.bin

# --- Detectie laag 3: lokaal LLM (standaard uit) -----------------------------

# Ollama draait lokaal; deze URL wordt alleen aangesproken als laag 3 actief is.
OLLAMA_HOST=http://localhost:11434

# Klein model dat past op M1 8 GB (ca. 1.4 GB op disk).
OLLAMA_MODEL=qwen3:1.7b

# Eval-only: laag 3 via Ollama MLX-backend (TESTPLAN.md §8). Vereist:
#   OLLAMA_MLX=1 ollama serve
#   ollama pull qwen3.5:2b-nvfp4
# Runner: pylades_md_ollama_mlx
OLLAMA_MLX_MODEL=qwen3.5:2b-nvfp4

# Eval-only: alternatieve laag-3-backend via mlx_lm.server (Apple Silicon),
# modelvergelijking in het testharnas (TESTPLAN.md §8). Niet door de runtime
# gebruikt. Start de server met (uv haalt mlx-lm tijdelijk op):
#   uv run --with mlx-lm python -m mlx_lm.server --model mlx-community/Qwen3-1.7B-4bit --port 8081
MLX_HOST=http://localhost:8081
MLX_MODEL=mlx-community/Qwen3-1.7B-4bit

# --- Detectie laag 2: spaCy NL ----------------------------------------------

# `_md` past in 8 GB naast Cursor; `_lg` is voor v1.0.
SPACY_MODEL=nl_core_news_md

# --- Server ports ------------------------------------------------------------

PROXY_PORT=8080
UI_PORT=8501
